---
import { t, type Lang } from '../../i18n';
import Ctas from '../Ctas.astro';
import Print from '../Print.astro';
import { img } from '../../lib/images';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const zh = lang === 'zh';
// 中文 headline phrases stay whole; a line may break only after 、 (so a long first line wraps cleanly on phones)
const phrases = (s: string) => s.match(/[^、]+、?/g) ?? [s];
---
<div class="wrap hero">
  <p class="eyebrow">{c.hero.eyebrow}</p>
  <h1>{zh ? <>{phrases(c.hero.h1a).map((p) => <span class="ph">{p}</span>)}<br /><em class="ph">{c.hero.h1b}</em></> : <>{c.hero.h1a}<br /><em>{c.hero.h1b}</em></>}</h1>
  <p class="sub">{c.hero.sub}</p>
  <Ctas {lang} />
  <Print class="herofig" src={img('making', lang)} alt={c.hero.figAlt}
    widths={[800, 1200, 1800, 2400]} sizes="(max-width: 1300px) calc(100vw - 2 * var(--pad)), 1240px"
    fig={`${c.fig} 1`} caption={c.hero.fig} priority reveal={false} />
</div>
