---
// "Coming next": the Home dashboard. Its screenshot slot is HOME_DASH in src/lib/images.ts (text only while null).
import { t, type Lang } from '../../i18n';
import { heading } from '../../lib/zhHeading';
import { homeDash } from '../../lib/images';
import Print from '../Print.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const shot = homeDash(lang);
---
<section class="wrap" aria-labelledby="nx-h">
  <div class={shot ? 'create' : 'create solo'}>
    <div>
      <p class="kick">{c.next.k}</p>
      <h2 id="nx-h" set:html={heading(c.next.t, lang)} />
      <p class="lede">{c.next.l}</p>
      <p class="tag">{c.next.tag}</p>
    </div>
    {shot && <Print src={shot} alt={c.next.alt} widths={[600, 1200]} sizes="(max-width: 900px) calc(100vw - 2 * var(--pad)), 640px" />}
  </div>
</section>
