---
import { pathFor, type Lang } from '../../i18n';
import { promo } from '../../lib/promo';
interface Props { lang: Lang; watchPage?: boolean }
const { lang, watchPage = false } = Astro.props;
const film = promo(lang);
---
{film.available && (
  <section class="wrap film" aria-label={film.title}>
    <figure>
      <div class="print"><video controls playsinline preload="none" poster={film.poster} width="1920" height="1080" aria-label={film.title} aria-describedby="demo-note"><source src={film.src} type="video/mp4" /><a href={film.src}>{film.link}</a></video></div>
      <figcaption id="demo-note">{film.language}. {film.note} {!watchPage && <a href={pathFor(lang, 'demo')}>{film.link} →</a>}</figcaption>
    </figure>
  </section>
)}
<style>
  section.film { margin: 32px auto 0; padding-top: 0; }
  figure { margin: 0; }
  video { display: block; width: 100%; height: auto; }
  figcaption { margin-top: .8rem; max-width: 80ch; color: var(--ink3); font-size: .875rem; line-height: 1.6; }
  figcaption a { white-space: nowrap; }
</style>
