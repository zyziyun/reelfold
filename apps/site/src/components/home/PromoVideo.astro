---
// The promo film slot. To publish or swap the film: put the file at public/media/reelfold-promo.mp4 (H.264, 16:9)
// and a poster frame at public/media/reelfold-promo.jpg, then rebuild. Nothing renders while the mp4 is missing.
import fs from 'node:fs';
import path from 'node:path';
import { t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
export const PROMO = { src: '/media/reelfold-promo.mp4', poster: '/media/reelfold-promo.jpg' };
const pub = (p: string) => path.join(process.cwd(), 'public', p); // the build runs in apps/site
const has = fs.existsSync(pub(PROMO.src));
const poster = has && fs.existsSync(pub(PROMO.poster)) ? PROMO.poster : undefined;
---
{has && (
  <section class="wrap film" aria-label={c.film.label}>
    <div class="print"><video controls playsinline preload="none" poster={poster} width="1920" height="1080" aria-label={c.film.label}><source src={PROMO.src} type="video/mp4" /></video></div>
  </section>
)}
